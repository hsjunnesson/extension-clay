- name: clay
  type: table
  desc: "Functions and constants for building Clay layouts with retained Defold GUI nodes."
  members:
  - name: initialize
    type: function
    desc: "Creates a Clay surface rooted at a Defold GUI node."
    parameters:
    - name: root_node
      type: "node"
      desc: "GUI node used as the layout bounds and parent for generated nodes."
    - name: max_element_count
      type: "integer"
      desc: "Element capacity for this surface; defaults to 8192."
      optional: true
    returns:
    - name: surface
      type: "clay.Surface"
      desc: "New Clay surface."

  - name: destroy
    type: function
    desc: "Deletes generated GUI nodes and releases a surface. Call from the GUI script's final() function."
    parameters:
    - name: surface
      type: "clay.Surface"
      desc: "Clay surface."

  - name: layout
    type: function
    desc: "Lays out one declarative element tree and reconciles its render commands with retained GUI nodes. The root table may be constructed for this call or retained and mutated between calls. Element-specific parsing errors raised by the binding include the current declaration's explicit ID when available. Errors preserve the previous retained GUI tree and leave the surface ready for the next frame."
    parameters:
    - name: surface
      type: "clay.Surface"
      desc: "Clay surface."
    - name: root
      type: "clay.Element"
      desc: "Root element declaration."
    - name: dt
      type: "number"
      desc: "Frame delta time in seconds; defaults to zero."
      optional: true

  - name: text
    type: function
    desc: "Creates a text declaration for an element's children array."
    parameters:
    - name: text
      type: "string"
      desc: "Text content."
    - name: config
      type: "clay.TextConfig"
      desc: "Text layout and rendering configuration."
    returns:
    - name: text_element
      type: "clay.Text"
      desc: "Mutable text declaration."


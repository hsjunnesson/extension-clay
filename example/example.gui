script: "/example/example.gui_script"
fonts {
  name: "heading"
  font: "/example/fonts/heading.font"
}
fonts {
  name: "Default"
  font: "/builtins/fonts/default.font"
}
fonts {
  name: "joyful"
  font: "/example/fonts/joyful.font"
}
textures {
  name: "example"
  texture: "/example/example.atlas"
}
nodes {
  size {
    x: 1280.0
    y: 720.0
  }
  type: TYPE_BOX
  id: "clay_root"
  xanchor: XANCHOR_LEFT
  yanchor: YANCHOR_BOTTOM
  pivot: PIVOT_SW
  adjust_mode: ADJUST_MODE_STRETCH
  inherit_alpha: true
  size_mode: SIZE_MODE_AUTO
}
layers {
  name: "background"
}
layers {
  name: "text"
}
layers {
  name: "icon"
}
layers {
  name: "tooltip_background"
}
layers {
  name: "tooltip_text"
}
material: "/clay/materials/gui.material"
adjust_reference: ADJUST_REFERENCE_PARENT
max_nodes: 1024
